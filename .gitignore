# Editor/OS junk
*.swp
*.tmp
.DS_Store

# scratch/backup files
*.bak*

# quill session notes (harness-managed, not for tracking)
.quill/

# stray setup.sh / pacman output
log.log

# VSCodium: track only user settings, ignore caches/profile junk
.config/VSCodium/*
!.config/VSCodium/User
.config/VSCodium/User/*
!.config/VSCodium/User/settings.json
!.config/VSCodium/User/keybindings.json
!.config/VSCodium/User/snippets

# syncthing: device keys/config are per-machine, never commit
.config/syncthing/
