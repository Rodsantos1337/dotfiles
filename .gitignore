# Editor/OS junk
*.swp
*.tmp
*.DS_Store

# scratch/backup files
*.bak*

# python bytecode
__pycache__/
*.pyc

# node_modules (never commit)
node_modules/

# ttt runtime state (machine-specific)
.config/ttt/state.json
.config/ttt/state/

# quill session notes (harness-managed, not for tracking)
.quill/

# stray setup.sh / pacman output
log.log

# syncthing: device keys/config are per-machine, never commit
.config/syncthing/
