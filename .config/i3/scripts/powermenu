#!/usr/bin/env bash
# powermenu - rofi power menu (Everforest Dim via rofi theme)
# Binds: $mod+Shift+e
set -euo pipefail

choice=$(printf '%s\n' Lock Logout Suspend Shutdown Reboot | rofi -dmenu -i -p "Power") || exit 1

case "$choice" in
    Lock)     i3lock ;;
    Logout)   i3-msg exit ;;
    Suspend)  systemctl suspend ;;
    Shutdown) systemctl poweroff ;;
    Reboot)   systemctl reboot ;;
esac