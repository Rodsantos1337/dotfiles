#!/usr/bin/env bash
# refresh-toggle - toggle primary panel between high refresh and 60Hz
# Desktop (DP-0 1920x1080): 74.92Hz <-> 60.00Hz
# Laptop (eDP-1 1920x1080, Gigabyte G5 KF): 144.00Hz <-> 60.00Hz
# Auto-detects OUT via xrandr --query. Binds: $mod+Shift+x
# Notifies via dunst with replace id -r 9912 to avoid stacking
set -euo pipefail

MODE="1920x1080"

# auto-detect panel: desktop DP-0 first, then laptop eDP-1
# guard: no-op on machines without either panel
if xrandr --query | grep -q "^DP-0 connected"; then
  OUT="DP-0"
  RATE_HIGH="74.92"
  RATE_LOW="60.00"
  LABEL_HIGH="75Hz"
  LABEL_LOW="60Hz"
elif xrandr --query | grep -q "^eDP-1 connected"; then
  OUT="eDP-1"
  RATE_HIGH="144.00"
  RATE_LOW="60.00"
  LABEL_HIGH="144Hz"
  LABEL_LOW="60Hz"
else
  notify-send -t 2000 -r 9912 "Refresh Rate" "DP-0/eDP-1 not connected"
  exit 0
fi

# detect current rate: extract the starred rate (e.g. 144.00* or 60.01*)
cur_line=$(xrandr --query | grep -A1 "^${OUT} connected" | grep -m1 '\*' || true)
if [[ -z "$cur_line" ]]; then
  notify-send -t 2000 -r 9912 "Refresh Rate" "no modes on $OUT"
  exit 0
fi
# cur_line example: "   1920x1080    74.92*+  60.00 ..."
cur_rate=$(echo "$cur_line" | grep -oE '[0-9]+\.[0-9]+\*' | head -1 | tr -d '*')
high_prefix="${RATE_HIGH%%.*}"
if [[ "$cur_rate" == "${high_prefix}"* ]]; then
  target="$RATE_LOW"
  label="$LABEL_LOW"
else
  target="$RATE_HIGH"
  label="$LABEL_HIGH"
fi

# try exact rate first, fallback to integer if mode not found
if ! xrandr --output "$OUT" --mode "$MODE" --rate "$target" 2>/dev/null; then
  # fallback: strip decimal for xrandr matching
  short="${label%Hz}"
  if ! xrandr --output "$OUT" --mode "$MODE" --rate "$short" 2>/dev/null; then
    notify-send -t 2000 -r 9912 "Refresh Rate" "$MODE @ $target unavailable on $OUT"
    exit 0
  fi
fi

notify-send -t 1500 -r 9912 "Refresh Rate" "$label ($MODE @ $OUT)"
