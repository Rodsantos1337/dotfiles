#!/usr/bin/env bash
# power-profiles - rofi power profile switcher (Everforest Dim via rofi theme)
# Binds: $mod+Shift+p
# Requires powerprofiles-daemon (extra) + python-gobject for powerprofilesctl.
set -euo pipefail

if ! command -v powerprofilesctl >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
        hint="power-profiles-daemon not installed (sudo dnf install power-profiles-daemon)"
    else
        hint="power-profiles-daemon not installed (sudo pacman -S power-profiles-daemon)"
    fi
    printf '%s\n' "$hint" | \
        rofi -dmenu -p "Power profile"
    exit 1
fi

profiles=$(powerprofilesctl list 2>/dev/null | grep -E '^\s*\*?\s*[a-z]+' | tr -d '* :')

if [[ -z "$profiles" ]]; then
    printf '%s\n' "No power profiles available" | \
        rofi -dmenu -p "Power profile"
    exit 1
fi

choice=$(printf '%s\n' $profiles | rofi -dmenu -i -p "Power profile") || exit 1

if [[ -n "$choice" ]]; then
    powerprofilesctl set "$choice"
    # bar is polybar (polls pp-indicator); no i3blocks to signal
    pkill -SIGRTMIN+2 i3blocks 2>/dev/null || true
fi
