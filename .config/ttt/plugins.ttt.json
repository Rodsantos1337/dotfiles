[
  {
    "name": "spell",
    "displayName": "Spell Check",
    "repo": "https://github.com/eugenioenko/ttt-spell",
    "version": "0.1.0",
    "enabled": true,
    "permissions": {
      "commands": true,
      "keybindings": true,
      "editor.read": true,
      "editor.write": true,
      "editor.diagnostics": true,
      "system.exec": [
        "aspell"
      ],
      "network.http": false,
      "events.file": true,
      "events.editor": true,
      "settings": true,
      "settings_keys": [
        "spell.*"
      ]
    },
    "grantsVersion": 2
  },
