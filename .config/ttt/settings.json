{
  "version": 1,
  "theme": "salvia-dim",
  "appearance": {
    "icons": "none",
    "overrides": {
      "chevron-down": "-",
      "chevron-right": "+"
    },
    "scrollbarGlyphs": "blocks",
    "pointerShapes": true
  },
  "editor": {
    "autoClosing": {
      "brackets": false,
      "quotes": false,
      "skipClosing": true,
      "deletePairs": true,
      "inStrings": false,
      "plainText": false
    },
    "tabSize": 4,
    "insertSpaces": true,
    "wordWrap": true,
    "wordWrapColumn": 0,
    "diffMode": "split",
    "diffContext": "changes",
    "diffWordWrap": false,
    "diffHighContrast": false,
    "diffEmphasizeCollapsedRows": false,
    "diffSigns": false,
    "diffSignsColor": true,
    "diffGutterHighlight": true,
    "diffColorGutterNumbers": false,
    "diffScrollbarGitMarks": false,
    "lineNumbers": true,
    "selectionStyle": "background",
    "formatOnSave": false,
    "insertFinalNewline": true,
    "trimTrailingWhitespace": false,
    "focusOnOpen": false,
    "gutterStyle": "compact",
    "borderStyle": "rounded",
    "bracketPairColorization": false,
    "menuBar": false,
    "transparentBackground": false,
    "saveAllOnQuit": false,
    "saveAllOnQuitExceptUnnamed": false
  },
  "quickOpen": {
    "showHidden": false,
    "showGitIgnored": false
  },
  "search": {
    "debounce": 350
  },
  "explorer": {
    "showHidden": true,
    "showGitIgnored": true,
    "gitStatusColors": true,
    "dimStagedGitColors": false,
    "autoReveal": false,
    "compactFolders": true
  },
  "sidebar": {
    "tabStyle": "label"
  },
  "git": {
    "fileView": "list"
  },
  "terminal": {
    "scrollback": 1000,
    "selectionStyle": "background",
    "ctrlVPastes": true,
    "padding_x": 1
  },
  "lsp": {
    "servers": {
      "css": {
        "command": [
          "vscode-css-language-server",
          "--stdio"
        ],
        "languages": {
          ".css": "css",
          ".less": "less",
          ".scss": "scss"
        }
      },
      "go": {
        "command": [
          "gopls"
        ]
      },
      "html": {
        "command": [
          "vscode-html-language-server",
          "--stdio"
        ]
      },
      "markdown": {
        "command": [
          "marksman",
          "server"
        ]
      },
      "typescript": {
        "command": [
          "typescript-language-server",
          "--stdio"
        ],
        "languages": {
          ".cjs": "javascript",
          ".cts": "typescript",
          ".js": "javascript",
          ".jsx": "javascriptreact",
          ".mjs": "javascript",
          ".mts": "typescript",
          ".ts": "typescript",
          ".tsx": "typescriptreact"
        }
      }
    },
    "saveOnRename": false,
    "hoverDelay": 500,
    "notifyAvailability": false
  },
  "autocomplete": {
    "enabled": true,
    "autoSuggest": true,
    "debounce": 150,
    "signatureHelp": true
  },
  "markdown": {
    "wrapWidth": 80
  },
  "image": {
    "protocol": "auto"
  },
  "plugins": {
    "selectionStyle": "invert"
  },
  "formatters": {
    "bash": "shfmt",
    "sh": "shfmt"
  }
}
