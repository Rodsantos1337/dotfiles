{
  "name": "tab-complete",
  "displayName": "Tab Complete",
  "description": "Cursor-style inline completions from a local OpenAI-compatible model (LM Studio, Ollama, llama.cpp).",
  "version": "0.1.0",
  "author": "fork tweak",
  "entry": "init.lua",
  "api": 1,
  "permissions": {
    "commands": true,
    "editor.read": true,
    "editor.write": true,
