{
  "name": "ttt-ghost",
  "displayName": "Ghost Complete",
  "description": "Copilot-style Tab completion from any OpenAI-compatible API, rendered as inline virtual text",
  "version": "0.1.0",
  "author": "local",
  "entry": "init.lua",
  "api": 2,
  "permissions": {
    "commands": true,
    "keybindings": true,
    "editor.read": true,
    "editor.write": true,
    "events.editor": true,
    "events.file": true,
    "network.http": true,
    "system.env": true,
    "system.exec": ["curl"],
    "storage": true
  }
}
