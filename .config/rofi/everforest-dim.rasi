/* everforest-dim - Everforest Green Dark Dim for rofi
   bg #1e2326 / base #232a2e / hover #2e383c / border #3a4141
   fg #ffffff / green #a7c080 / red #e67e80 */

* {
  bg:     #1e2326;
  base:   #232a2e;
  hover:  #2e383c;
  border: #3a4141;
  fg:     #ffffff;
  muted:  #7a8478;
  green:  #a7c080;
  red:    #e67e80;
  font:   "Inter 11";
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @border;
  border-radius: 6px;
  width: 600px;
  padding: 12px;
}

mainbox {
  background-color: transparent;
  spacing: 8px;
}

inputbar {
  background-color: @base;
  border-radius: 4px;
  padding: 8px;
  spacing: 8px;
}

prompt {
  background-color: transparent;
  text-color: @green;
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder-color: @muted;
}

listview {
  background-color: transparent;
  lines: 10;
  spacing: 2px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 4px;
  padding: 4px 8px;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @green;
  text-color: @bg;
}

element urgent.normal {
  background-color: transparent;
  text-color: @red;
}

element-text, element-icon {
  background-color: transparent;
  text-color: inherit;
}
