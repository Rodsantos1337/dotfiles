/* salvia-dim - Salvia Dim for rofi
   bg #0f1010 / base #171818 / hover #1f2020 / border #272928
   fg #e4e2d8 / green (sage) #a8bf9c / red #cf6f63 */

* {
  bg:     #0f1010;
  base:   #171818;
  hover:  #1f2020;
  border: #272928;
  fg:     #e4e2d8;
  muted:  #878a85;
  green:  #a8bf9c;
  red:    #cf6f63;
  font:   "Inter 12";
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @border;
  border-radius: 6px;
  width: 600px;
  padding: 12px;
}

mainbox {
  background-color: transparent;
  spacing: 8px;
}

inputbar {
  background-color: @base;
  border-radius: 4px;
  padding: 8px;
  spacing: 8px;
}

prompt {
  background-color: transparent;
  text-color: @green;
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder-color: @muted;
}

listview {
  background-color: transparent;
  lines: 10;
  spacing: 2px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 4px;
  padding: 4px 8px;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @green;
  text-color: @bg;
}

element urgent.normal {
  background-color: transparent;
  text-color: @red;
}

element-text, element-icon {
  background-color: transparent;
  text-color: inherit;
}
