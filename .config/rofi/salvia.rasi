/* salvia - Salvia for rofi
   bg #1b1c1c / base #242626 / hover #303231 / border #3b3e3c
   fg #e8e6dc / green (sage) #a8bf9c / red #cf6f63 */

* {
  bg:     #1b1c1c;
  base:   #242626;
  hover:  #303231;
  border: #3b3e3c;
  fg:     #e8e6dc;
  muted:  #979a94;
  green:  #a8bf9c;
  red:    #cf6f63;
  font:   "Inter 12";
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @border;
  border-radius: 6px;
  width: 600px;
  padding: 12px;
}

mainbox {
  background-color: transparent;
  spacing: 8px;
}

inputbar {
  background-color: @base;
  border-radius: 4px;
  padding: 8px;
  spacing: 8px;
}

prompt {
  background-color: transparent;
  text-color: @green;
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder-color: @muted;
}

listview {
  background-color: transparent;
  lines: 10;
  spacing: 2px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 4px;
  padding: 4px 8px;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @green;
  text-color: @bg;
}

element urgent.normal {
  background-color: transparent;
  text-color: @red;
}

element-text, element-icon {
  background-color: transparent;
  text-color: inherit;
}
